generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                      String                   @id @default(uuid()) @db.Uuid
  mobile                  String                   @unique
  firstName               String                   @default("")
  lastName                String                   @default("")
  email                   String?
  birthDate               DateTime?
  nationalId              String?
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  sessions                AuthSession[]
  otpChallenges           OtpChallenge[]
  passengers              Passenger[]
  checkoutSessions        CheckoutSession[]
  orders                  Order[]
  wallet                  Wallet?
  favorites               Favorite[]
  notifications           Notification[]
  supportTickets          SupportTicket[]
  visaApplications        VisaApplication[]
  refunds                 RefundRequest[]
  organizationMemberships OrganizationMembership[]
  auditLogs               AuditLog[]               @relation("AuditActorUser")
  programModerationEvents TravelProgramModerationEvent[]
  registrationNotes       TravelRegistrationNote[]
  supportMessages         SupportMessage[]         @relation("SupportMessageAuthor")
}

model Organization {
  id               String                   @id @default(uuid()) @db.Uuid
  type             String
  name             String
  legalName        String?
  slug             String                   @unique
  status           String                   @default("ACTIVE")
  contactEmail     String?
  contactMobile    String?
  metadata         Json?
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt
  merchantProfile  MerchantProfile?
  memberships      OrganizationMembership[]
  commissionRules  CommissionRule[]
  ledgerEntries    MerchantLedgerEntry[]
  settlements      SettlementBatch[]
  documents        MerchantDocument[]
  merchantOrders   Order[]                  @relation("MerchantOrders")
  supplierOrders   Order[]                  @relation("SupplierOrders")
  merchantBookings BookingAttempt[]         @relation("MerchantBookingAttempts")
  supplierBookings BookingAttempt[]         @relation("SupplierBookingAttempts")
  auditActorLogs   AuditLog[]               @relation("AuditActorOrganization")
  auditTargetLogs  AuditLog[]               @relation("AuditTargetOrganization")
  travelPrograms   TravelProgram[]
  programModerationEvents TravelProgramModerationEvent[]
  properties       Property[]
  supportTickets   SupportTicket[]

  @@index([type, status])
}

model MerchantProfile {
  id               String       @id @default(uuid()) @db.Uuid
  organizationId   String       @unique @db.Uuid
  merchantCode     String       @unique
  businessType     String
  onboardingStatus String       @default("DRAFT")
  contractStatus   String       @default("NOT_STARTED")
  settlementStatus String       @default("INACTIVE")
  legalIdentifier  String?
  taxIdentifier    String?
  supportPhone     String?
  metadata         Json?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([businessType, onboardingStatus])
}

model OrganizationMembership {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @db.Uuid
  userId         String           @db.Uuid
  status         String           @default("ACTIVE")
  invitedAt      DateTime?
  joinedAt       DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  roles          MembershipRole[]

  @@unique([organizationId, userId])
  @@index([userId, status])
  @@index([organizationId, status])
}

model Role {
  id          String           @id @default(uuid()) @db.Uuid
  code        String           @unique
  name        String
  scope       String
  description String?
  isSystem    Boolean          @default(true)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  permissions RolePermission[]
  memberships MembershipRole[]

  @@index([scope])
}

model Permission {
  id          String           @id @default(uuid()) @db.Uuid
  code        String           @unique
  description String?
  createdAt   DateTime         @default(now())
  roles       RolePermission[]
}

model RolePermission {
  roleId       String     @db.Uuid
  permissionId String     @db.Uuid
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
}

model MembershipRole {
  membershipId String                 @db.Uuid
  roleId       String                 @db.Uuid
  membership   OrganizationMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  role         Role                   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([membershipId, roleId])
  @@index([roleId])
}

model AuditLog {
  id                   String        @id @default(uuid()) @db.Uuid
  actorUserId          String?       @db.Uuid
  actorOrganizationId  String?       @db.Uuid
  targetOrganizationId String?       @db.Uuid
  action               String
  resourceType         String
  resourceId           String?
  beforeData           Json?
  afterData            Json?
  metadata             Json?
  requestId            String?
  ipAddress            String?
  userAgent            String?
  createdAt            DateTime      @default(now())
  actorUser            User?         @relation("AuditActorUser", fields: [actorUserId], references: [id], onDelete: Restrict)
  actorOrganization    Organization? @relation("AuditActorOrganization", fields: [actorOrganizationId], references: [id], onDelete: Restrict)
  targetOrganization   Organization? @relation("AuditTargetOrganization", fields: [targetOrganizationId], references: [id], onDelete: Restrict)

  @@index([createdAt])
  @@index([actorUserId, createdAt])
  @@index([resourceType, resourceId, createdAt])
  @@index([targetOrganizationId, createdAt])
}

model AuthSession {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model OtpChallenge {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String?   @db.Uuid
  mobile    String
  codeHash  String
  expiresAt DateTime
  attempts  Int       @default(0)
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([mobile, expiresAt])
  @@index([mobile, createdAt])
}

model Passenger {
  id             String    @id @default(uuid()) @db.Uuid
  userId         String    @db.Uuid
  firstName      String
  lastName       String
  birthDate      DateTime?
  nationalId     String?
  passportNumber String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model CheckoutSession {
  id             String           @id @default(uuid()) @db.Uuid
  userId         String?          @db.Uuid
  guestMobile    String?
  serviceType    String
  status         String           @default("ready_for_payment")
  service        Json
  buyer          Json
  travelers      Json
  addOns         Json
  coupon         String?
  pricing        Json
  total          Int
  currency       String           @default("TOMAN")
  expiresAt      DateTime
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  user           User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  order          Order?
  payments       PaymentAttempt[]
  paymentIntents PaymentIntent[]

  @@index([userId, createdAt])
  @@index([guestMobile, createdAt])
  @@index([status, expiresAt])
}

model OrderCounter {
  id        Int      @id
  nextValue Int      @default(0)
  updatedAt DateTime @updatedAt
}

model Order {
  id                     String                @id @default(uuid()) @db.Uuid
  userId                 String?               @db.Uuid
  merchantOrganizationId String?               @db.Uuid
  supplierOrganizationId String?               @db.Uuid
  checkoutSessionId      String                @unique @db.Uuid
  orderNumber            String                @unique
  trackingCode           String                @unique
  guestMobile            String?
  serviceType            String
  summary                Json
  buyer                  Json
  travelers              Json
  serviceSnapshot        Json
  pricingSnapshot        Json
  paymentSnapshot        Json
  total                  Int
  currency               String                @default("TOMAN")
  paymentStatus          String                @default("paid")
  bookingStatus          String                @default("pending")
  providerName           String?
  externalReference      String?
  providerPayload        Json?
  relevantDate           DateTime?
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt
  user                   User?                 @relation(fields: [userId], references: [id], onDelete: SetNull)
  merchantOrganization   Organization?         @relation("MerchantOrders", fields: [merchantOrganizationId], references: [id], onDelete: SetNull)
  supplierOrganization   Organization?         @relation("SupplierOrders", fields: [supplierOrganizationId], references: [id], onDelete: SetNull)
  checkoutSession        CheckoutSession       @relation(fields: [checkoutSessionId], references: [id], onDelete: Restrict)
  payments               PaymentAttempt[]
  refunds                RefundRequest[]
  transactions           Transaction[]
  bookingAttempts        BookingAttempt[]
  merchantLedgerEntries  MerchantLedgerEntry[]
  travelProgram          TravelProgram?        @relation(fields: [travelProgramId], references: [id], onDelete: SetNull)
  travelProgramDeparture TravelProgramDeparture? @relation(fields: [travelProgramDepartureId], references: [id], onDelete: SetNull)
  travelProgramPackage   TravelProgramPackage? @relation(fields: [travelProgramPackageId], references: [id], onDelete: SetNull)
  registrationNotes      TravelRegistrationNote[]
  supportTickets         SupportTicket[]
  property               Property?             @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  roomType               RoomType?             @relation(fields: [roomTypeId], references: [id], onDelete: SetNull)
  ratePlan               RatePlan?             @relation(fields: [ratePlanId], references: [id], onDelete: SetNull)
  travelProgramId          String?               @db.Uuid
  travelProgramDepartureId String?               @db.Uuid
  travelProgramPackageId   String?               @db.Uuid
  propertyId                String?               @db.Uuid
  roomTypeId                String?               @db.Uuid
  ratePlanId                String?               @db.Uuid

  @@index([userId, createdAt])
  @@index([guestMobile, createdAt])
  @@index([bookingStatus, updatedAt])
  @@index([createdAt])
  @@index([serviceType, createdAt])
  @@index([paymentStatus, createdAt])
  @@index([bookingStatus, createdAt])
  @@index([merchantOrganizationId, createdAt])
  @@index([supplierOrganizationId, createdAt])
  @@index([travelProgramId, createdAt])
  @@index([travelProgramDepartureId, createdAt])
  @@index([travelProgramPackageId, createdAt])
  @@index([propertyId, relevantDate])
  @@index([roomTypeId, relevantDate])
  @@index([ratePlanId, relevantDate])
}

model PaymentAttempt {
  id                String          @id @default(uuid()) @db.Uuid
  checkoutSessionId String          @db.Uuid
  orderId           String?         @db.Uuid
  provider          String
  method            String
  status            String
  amount            Int
  walletAmount      Int             @default(0)
  onlineAmount      Int             @default(0)
  idempotencyKey    String
  reference         String?         @unique
  metadata          Json?
  createdAt         DateTime        @default(now())
  completedAt       DateTime?
  checkoutSession   CheckoutSession @relation(fields: [checkoutSessionId], references: [id], onDelete: Cascade)
  order             Order?          @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@unique([checkoutSessionId, idempotencyKey])
  @@index([orderId, createdAt])
  @@index([status, createdAt])
}

model PaymentIntent {
  id                String                @id @default(uuid()) @db.Uuid
  checkoutSessionId String                @db.Uuid
  provider          String
  method            String
  amount            Int
  currency          String                @default("TOMAN")
  status            String                @default("created")
  idempotencyKey    String
  externalReference String                @unique
  redirectUrl       String
  metadata          Json?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  checkoutSession   CheckoutSession       @relation(fields: [checkoutSessionId], references: [id], onDelete: Cascade)
  callbacks         PaymentCallback[]
  verifications     PaymentVerification[]

  @@unique([checkoutSessionId, idempotencyKey])
  @@index([externalReference, status])
}

model PaymentCallback {
  id                String        @id @default(uuid()) @db.Uuid
  paymentIntentId   String        @db.Uuid
  provider          String
  externalReference String
  status            String
  signature         String?
  payload           Json?
  callbackKey       String        @unique
  processedAt       DateTime?
  createdAt         DateTime      @default(now())
  paymentIntent     PaymentIntent @relation(fields: [paymentIntentId], references: [id], onDelete: Cascade)

  @@index([externalReference, createdAt])
}

model PaymentVerification {
  id                String        @id @default(uuid()) @db.Uuid
  paymentIntentId   String        @db.Uuid
  provider          String
  externalReference String
  status            String
  errorCode         String?
  response          Json?
  createdAt         DateTime      @default(now())
  paymentIntent     PaymentIntent @relation(fields: [paymentIntentId], references: [id], onDelete: Cascade)

  @@index([externalReference, createdAt])
}

model Transaction {
  id        String   @id @default(uuid()) @db.Uuid
  orderId   String?  @db.Uuid
  walletId  String?  @db.Uuid
  type      String
  status    String
  amount    Int
  currency  String   @default("TOMAN")
  reference String   @unique
  createdAt DateTime @default(now())
  order     Order?   @relation(fields: [orderId], references: [id], onDelete: SetNull)
  wallet    Wallet?  @relation(fields: [walletId], references: [id], onDelete: SetNull)
}

model Wallet {
  id           String              @id @default(uuid()) @db.Uuid
  userId       String              @unique @db.Uuid
  balance      Int                 @default(0)
  currency     String              @default("TOMAN")
  updatedAt    DateTime            @updatedAt
  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions WalletTransaction[]
  ledger       Transaction[]
}

model WalletTransaction {
  id           String   @id @default(uuid()) @db.Uuid
  walletId     String   @db.Uuid
  type         String
  amount       Int
  balanceAfter Int
  reference    String   @unique
  createdAt    DateTime @default(now())
  wallet       Wallet   @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([walletId, createdAt])
}

model RefundRequest {
  id                String    @id @default(uuid()) @db.Uuid
  orderId           String    @db.Uuid
  userId            String?   @db.Uuid
  amount            Int
  reason            String
  destination       String
  status            String    @default("requested")
  compensationKey   String?   @unique
  walletAmount      Int       @default(0)
  onlineAmount      Int       @default(0)
  providerReference String?
  completedAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  order             Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user              User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([orderId, status])
  @@index([userId, createdAt])
  @@index([status, createdAt])
}

model Favorite {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  itemType  String
  itemId    String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, itemType, itemId])
}

model Notification {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  type      String    @default("system")
  title     String
  body      String
  readAt    DateTime?
  dedupeKey String?   @unique
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, readAt])
}

model SupportTicket {
  id        String           @id @default(uuid()) @db.Uuid
  userId    String?          @db.Uuid
  subject   String
  status    String           @default("open")
  orderId   String?          @db.Uuid
  organizationId String?     @db.Uuid
  category  String           @default("general")
  internalNote String?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  user      User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  order     Order?           @relation(fields: [orderId], references: [id], onDelete: SetNull)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  messages  SupportMessage[]

  @@index([userId, createdAt])
  @@index([organizationId, status, updatedAt])
  @@index([orderId])
}

model SupportMessage {
  id         String        @id @default(uuid()) @db.Uuid
  ticketId   String        @db.Uuid
  authorType String
  body       String
  authorUserId String?      @db.Uuid
  internal   Boolean       @default(false)
  createdAt  DateTime      @default(now())
  ticket     SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorUser User?         @relation("SupportMessageAuthor", fields: [authorUserId], references: [id], onDelete: SetNull)

  @@index([ticketId, createdAt])
}

model Property {
  id                String       @id @default(uuid()) @db.Uuid
  organizationId    String       @db.Uuid
  slug              String       @unique
  name              String
  city              String
  country           String       @default("ایران")
  address            String
  area               String?
  latitude           Decimal?    @db.Decimal(9, 6)
  longitude          Decimal?    @db.Decimal(9, 6)
  stars              Int
  description        String
  checkInTime        String       @default("14:00")
  checkOutTime       String       @default("12:00")
  sourceType         String       @default("DIRECT")
  supplierCode       String?
  publicationStatus String       @default("DRAFT")
  operationalStatus String       @default("ACTIVE")
  amenities          Json?
  policies           Json?
  images             Json?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  organization       Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  roomTypes          RoomType[]
  orders             Order[]

  @@index([organizationId, publicationStatus])
  @@index([city, publicationStatus, operationalStatus])
  @@index([sourceType, operationalStatus])
}

model RoomType {
  id          String           @id @default(uuid()) @db.Uuid
  propertyId  String           @db.Uuid
  name        String
  description String
  capacity    Int
  bedType     String
  sizeSqm     Int?
  amenities   Json?
  images      Json?
  status      String           @default("ACTIVE")
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  property    Property         @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  ratePlans   RatePlan[]
  orders      Order[]

  @@unique([propertyId, name])
  @@index([propertyId, status])
}

model RatePlan {
  id                 String           @id @default(uuid()) @db.Uuid
  roomTypeId         String           @db.Uuid
  title              String
  mealPlan           String
  refundable         Boolean          @default(false)
  cancellationPolicy String
  baseRate           Int
  currency           String           @default("TOMAN")
  taxesIncluded      Boolean          @default(true)
  status             String           @default("ACTIVE")
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  roomType           RoomType         @relation(fields: [roomTypeId], references: [id], onDelete: Cascade)
  inventory          DailyInventory[]
  orders             Order[]

  @@unique([roomTypeId, title])
  @@index([roomTypeId, status])
}

model DailyInventory {
  id             String   @id @default(uuid()) @db.Uuid
  ratePlanId     String   @db.Uuid
  date           DateTime @db.Date
  availableRooms Int
  priceOverride  Int?
  closed         Boolean  @default(false)
  minimumStay    Int      @default(1)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  ratePlan       RatePlan @relation(fields: [ratePlanId], references: [id], onDelete: Cascade)

  @@unique([ratePlanId, date])
  @@index([date, closed])
}

model VisaApplication {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  country   String
  status    String   @default("draft")
  payload   Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model SmsDeliveryAttempt {
  id                String   @id @default(uuid()) @db.Uuid
  mobile            String
  template          String
  provider          String
  status            String
  providerReference String?
  errorCode         String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([mobile, createdAt])
  @@index([providerReference])
}

model BookingAttempt {
  id                     String                @id @default(uuid()) @db.Uuid
  orderId                String?               @db.Uuid
  merchantOrganizationId String?               @db.Uuid
  supplierOrganizationId String?               @db.Uuid
  provider               String
  requestKey             String                @unique
  providerReference      String?
  status                 String
  requestSnapshot        Json?
  responseSnapshot       Json?
  error                  String?
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt
  order                  Order?                @relation(fields: [orderId], references: [id], onDelete: SetNull)
  merchantOrganization   Organization?         @relation("MerchantBookingAttempts", fields: [merchantOrganizationId], references: [id], onDelete: SetNull)
  supplierOrganization   Organization?         @relation("SupplierBookingAttempts", fields: [supplierOrganizationId], references: [id], onDelete: SetNull)
  merchantLedgerEntries  MerchantLedgerEntry[]

  @@index([orderId, createdAt])
  @@index([provider, status])
  @@index([merchantOrganizationId, createdAt])
  @@index([supplierOrganizationId, createdAt])
}

model TravelProgram {
  id                 String                         @id @default(uuid()) @db.Uuid
  organizationId     String                         @db.Uuid
  type               String
  slug               String                         @unique
  title              String
  shortDescription   String?
  description        String
  origin             String
  durationDays       Int
  durationNights     Int
  sourceType         String                         @default("DIRECT")
  status             String                         @default("ACTIVE")
  publicationStatus  String                         @default("DRAFT")
  featured           Boolean                        @default(false)
  futureSalePolicy   Boolean                        @default(false)
  visaNote           String?
  cancellationPolicy String
  guideNote          String?
  submittedAt        DateTime?
  publishedAt        DateTime?
  archivedAt         DateTime?
  createdAt          DateTime                       @default(now())
  updatedAt          DateTime                       @updatedAt
  organization       Organization                   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  destinations       TravelProgramDestination[]
  departures         TravelProgramDeparture[]
  packages           TravelProgramPackage[]
  itinerary          TravelProgramItineraryDay[]
  contentItems       TravelProgramContentItem[]
  media              TravelProgramMedia[]
  moderationEvents   TravelProgramModerationEvent[]
  orders             Order[]

  @@index([organizationId, type, publicationStatus])
  @@index([type, publicationStatus, featured])
  @@index([status, updatedAt])
}

model TravelProgramDestination {
  id        String        @id @default(uuid()) @db.Uuid
  programId String        @db.Uuid
  city      String
  country   String
  label     String
  sortOrder Int           @default(0)
  program   TravelProgram @relation(fields: [programId], references: [id], onDelete: Cascade)

  @@index([programId, sortOrder])
  @@index([city, country])
}

model TravelProgramDeparture {
  id               String                 @id @default(uuid()) @db.Uuid
  programId        String                 @db.Uuid
  startDate        DateTime
  endDate          DateTime
  transportType    String
  transportDetails String?
  totalCapacity    Int
  heldCapacity     Int                    @default(0)
  saleStatus       String                 @default("DRAFT")
  salesStartAt     DateTime?
  salesEndAt       DateTime?
  notes            String?
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  program          TravelProgram          @relation(fields: [programId], references: [id], onDelete: Cascade)
  packages         TravelProgramPackage[]
  orders           Order[]

  @@index([programId, startDate])
  @@index([saleStatus, startDate])
}

model TravelProgramPackage {
  id               String                  @id @default(uuid()) @db.Uuid
  programId        String                  @db.Uuid
  departureId      String?                 @db.Uuid
  name             String
  hotelName        String?
  hotelStars       Int?
  roomType         String?
  mealPlan         String?
  transport        String?
  adultPrice       Int
  childPrice       Int
  infantPrice      Int                     @default(0)
  singleSupplement Int                     @default(0)
  capacity         Int?
  status           String                  @default("ACTIVE")
  metadata         Json?
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt
  program          TravelProgram           @relation(fields: [programId], references: [id], onDelete: Cascade)
  departure        TravelProgramDeparture? @relation(fields: [departureId], references: [id], onDelete: Cascade)
  orders           Order[]

  @@index([programId, status])
  @@index([departureId, status])
}

model TravelProgramItineraryDay {
  id            String        @id @default(uuid()) @db.Uuid
  programId     String        @db.Uuid
  dayNumber     Int
  title         String
  description   String
  accommodation String?
  meals         String?
  transportNote String?
  activityNote  String?
  sortOrder     Int           @default(0)
  program       TravelProgram @relation(fields: [programId], references: [id], onDelete: Cascade)

  @@unique([programId, dayNumber])
  @@index([programId, sortOrder])
}

model TravelProgramContentItem {
  id        String        @id @default(uuid()) @db.Uuid
  programId String        @db.Uuid
  kind      String
  title     String
  detail    String?
  sortOrder Int           @default(0)
  program   TravelProgram @relation(fields: [programId], references: [id], onDelete: Cascade)

  @@index([programId, kind, sortOrder])
}

model TravelProgramMedia {
  id        String        @id @default(uuid()) @db.Uuid
  programId String        @db.Uuid
  url       String
  altText   String
  isCover   Boolean       @default(false)
  sortOrder Int           @default(0)
  program   TravelProgram @relation(fields: [programId], references: [id], onDelete: Cascade)

  @@index([programId, sortOrder])
}

model TravelProgramModerationEvent {
  id                  String        @id @default(uuid()) @db.Uuid
  programId           String        @db.Uuid
  actorUserId         String        @db.Uuid
  actorOrganizationId String        @db.Uuid
  action              String
  fromStatus          String?
  toStatus            String
  reason              String?
  createdAt           DateTime      @default(now())
  program             TravelProgram @relation(fields: [programId], references: [id], onDelete: Cascade)
  actorUser           User          @relation(fields: [actorUserId], references: [id], onDelete: Restrict)
  actorOrganization   Organization  @relation(fields: [actorOrganizationId], references: [id], onDelete: Restrict)

  @@index([programId, createdAt])
  @@index([toStatus, createdAt])
}

model TravelRegistrationNote {
  id          String   @id @default(uuid()) @db.Uuid
  orderId     String   @db.Uuid
  actorUserId String   @db.Uuid
  body        String
  createdAt   DateTime @default(now())
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  actorUser   User     @relation(fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([orderId, createdAt])
}

model CommissionRule {
  id              String       @id @default(uuid()) @db.Uuid
  organizationId  String       @db.Uuid
  serviceType     String
  calculationType String
  value           Int
  currency        String       @default("TOMAN")
  status          String       @default("ACTIVE")
  activeFrom      DateTime
  activeTo        DateTime?
  metadata        Json?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, serviceType, status])
  @@index([activeFrom, activeTo])
}

model MerchantLedgerEntry {
  id                String           @id @default(uuid()) @db.Uuid
  organizationId    String           @db.Uuid
  orderId           String?          @db.Uuid
  bookingAttemptId  String?          @db.Uuid
  settlementBatchId String?          @db.Uuid
  type              String
  amount            Int
  currency          String           @default("TOMAN")
  status            String           @default("POSTED")
  reference         String           @unique
  metadata          Json?
  createdAt         DateTime         @default(now())
  organization      Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  order             Order?           @relation(fields: [orderId], references: [id], onDelete: Restrict)
  bookingAttempt    BookingAttempt?  @relation(fields: [bookingAttemptId], references: [id], onDelete: Restrict)
  settlementBatch   SettlementBatch? @relation(fields: [settlementBatchId], references: [id], onDelete: Restrict)

  @@index([organizationId, createdAt])
  @@index([organizationId, type, createdAt])
  @@index([orderId])
  @@index([settlementBatchId])
}

model SettlementBatch {
  id                String                @id @default(uuid()) @db.Uuid
  organizationId    String                @db.Uuid
  periodStart       DateTime
  periodEnd         DateTime
  grossAmount       Int                   @default(0)
  commissionAmount  Int                   @default(0)
  refundAmount      Int                   @default(0)
  adjustmentAmount  Int                   @default(0)
  payableAmount     Int                   @default(0)
  currency          String                @default("TOMAN")
  status            String                @default("DRAFT")
  externalReference String?
  notes             String?
  approvedAt        DateTime?
  paidAt            DateTime?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  organization      Organization          @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  ledgerEntries     MerchantLedgerEntry[]

  @@index([organizationId, periodStart, periodEnd])
  @@index([organizationId, status, createdAt])
}

model MerchantDocument {
  id               String       @id @default(uuid()) @db.Uuid
  organizationId   String       @db.Uuid
  type             String
  status           String       @default("PENDING")
  storageReference String
  expiresAt        DateTime?
  metadata         Json?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, type, status])
  @@index([expiresAt])
}
