generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String            @id @default(uuid()) @db.Uuid
  mobile          String            @unique
  firstName       String            @default("")
  lastName        String            @default("")
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  sessions        AuthSession[]
  otpChallenges   OtpChallenge[]
  passengers      Passenger[]
  checkoutSessions CheckoutSession[]
  orders          Order[]
  wallet          Wallet?
  favorites       Favorite[]
  notifications   Notification[]
  supportTickets  SupportTicket[]
  visaApplications VisaApplication[]
  refunds         RefundRequest[]
}

model AuthSession {
  id String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  tokenHash String @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, expiresAt])
}
model OtpChallenge {
  id String @id @default(uuid()) @db.Uuid
  userId String? @db.Uuid
  mobile String
  codeHash String
  expiresAt DateTime
  attempts Int @default(0)
  usedAt DateTime?
  createdAt DateTime @default(now())
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)
  @@index([mobile, expiresAt])
}
model Passenger {
  id String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  firstName String
  lastName String
  birthDate DateTime?
  nationalId String?
  passportNumber String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
}
model CheckoutSession {
  id String @id @default(uuid()) @db.Uuid
  userId String? @db.Uuid
  serviceType String
  payload Json
  total Int
  expiresAt DateTime
  createdAt DateTime @default(now())
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)
  orders Order[]
  @@index([userId, expiresAt])
}
model Order {
  id String @id @default(uuid()) @db.Uuid
  userId String? @db.Uuid
  checkoutSessionId String? @db.Uuid
  trackingCode String @unique
  serviceType String
  status String
  total Int
  currency String @default("IRR")
  guestMobile String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)
  checkoutSession CheckoutSession? @relation(fields: [checkoutSessionId], references: [id], onDelete: SetNull)
  payments PaymentAttempt[]
  refunds RefundRequest[]
  transactions Transaction[]
  @@index([userId, createdAt])
  @@index([guestMobile, trackingCode])
}
model PaymentAttempt {
  id String @id @default(uuid()) @db.Uuid
  orderId String @db.Uuid
  provider String
  idempotencyKey String
  status String
  amount Int
  rawResponse Json?
  createdAt DateTime @default(now())
  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  @@unique([orderId, idempotencyKey])
}
model Transaction {
  id String @id @default(uuid()) @db.Uuid
  orderId String? @db.Uuid
  walletId String? @db.Uuid
  type String
  amount Int
  reference String @unique
  createdAt DateTime @default(now())
  order Order? @relation(fields: [orderId], references: [id], onDelete: SetNull)
  wallet Wallet? @relation(fields: [walletId], references: [id], onDelete: SetNull)
}
model Wallet {
  id String @id @default(uuid()) @db.Uuid
  userId String @unique @db.Uuid
  balance Int @default(0)
  currency String @default("IRR")
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions WalletTransaction[]
  ledger Transaction[]
}
model WalletTransaction {
  id String @id @default(uuid()) @db.Uuid
  walletId String @db.Uuid
  type String
  amount Int
  balanceAfter Int
  reference String @unique
  createdAt DateTime @default(now())
  wallet Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)
  @@index([walletId, createdAt])
}
model RefundRequest {
  id String @id @default(uuid()) @db.Uuid
  orderId String @db.Uuid
  userId String? @db.Uuid
  amount Int
  reason String
  status String @default("requested")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)
}
model Favorite {
  id String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  itemType String
  itemId String
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([userId, itemType, itemId])
}
model Notification {
  id String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  title String
  body String
  readAt DateTime?
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, createdAt])
}
model SupportTicket {
  id String @id @default(uuid()) @db.Uuid
  userId String? @db.Uuid
  subject String
  status String @default("open")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)
  messages SupportMessage[]
}
model SupportMessage {
  id String @id @default(uuid()) @db.Uuid
  ticketId String @db.Uuid
  authorType String
  body String
  createdAt DateTime @default(now())
  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
}
model VisaApplication {
  id String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  country String
  status String @default("draft")
  payload Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, createdAt])
}
