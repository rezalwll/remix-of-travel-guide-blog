NODE_ENV=development
API_PORT=8787
WEB_ORIGIN=http://localhost:8080
API_PUBLIC_URL=http://localhost:8787
SITE_URL=http://localhost:8080
API_INTERNAL_URL=http://127.0.0.1:8787
DATABASE_URL=postgresql://kiashi:kiashi@localhost:5432/kiashi
DATABASE_URL_TEST=postgresql://kiashi:kiashi@localhost:5432/kiashi_test
SESSION_TTL_HOURS=168
PROVIDER_TIMEOUT_MS=5000
PROVIDER_MAX_RESPONSE_BYTES=262144
# Only enable behind a trusted reverse proxy that overwrites forwarding headers.
TRUST_PROXY=false
LOG_LEVEL=info
APP_VERSION=0.0.0-dev
GIT_SHA=local
BUILD_TIME=unknown
RATE_LIMIT_STORE=memory
SMS_PROVIDER=development
SMS_PROVIDER_MODE=sandbox
# Real Melipayamak mode is fail-closed and sends OTP through BaseServiceNumber.
# SMS_PROVIDER=melipayamak
# SMS_PROVIDER_MODE=real
# SMS_PROVIDER_BASE_URL=https://rest.payamak-panel.com/api/SendSMS/
# SMS_PROVIDER_USERNAME=replace-me
# SMS_PROVIDER_API_KEY=replace-me
# SMS_PROVIDER_OTP_TEMPLATE=replace-with-approved-body-id
PAYMENT_PROVIDER=mock
PAYMENT_PROVIDER_MODE=sandbox
# PAYMENT_PROVIDER_BASE_URL=https://payments.example.invalid
# PAYMENT_PROVIDER_MERCHANT_ID=replace-me
# PAYMENT_PROVIDER_SECRET=replace-with-a-private-value
# Set a private 32+ character secret before running a production mock callback endpoint.
# MOCK_PAYMENT_SECRET=replace-with-a-long-random-private-value
FLIGHT_PROVIDER=mock
HOTEL_PROVIDER=mock
TRAIN_PROVIDER=mock
BUS_PROVIDER=mock
INSURANCE_PROVIDER=mock
CIP_PROVIDER=mock
TRANSFER_PROVIDER=mock
VISA_PROVIDER=mock
TRAVEL_PROVIDER_MODE=sandbox
# TRAVEL_PROVIDER_BASE_URL=https://supplier.example.invalid
# TRAVEL_PROVIDER_API_KEY=replace-me
